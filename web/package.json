{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prisma:generate": "prisma generate",
    "predev": "npm run prisma:generate",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run prisma:generate",
    "build": "next build",
    "start": "next start",
    "pretype-check": "npm run prisma:generate",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"prisma/**/*.{ts,tsx}\" \"scripts/**/*.{ts,tsx,mjs}\" \"*.{json,md}\"",
    "precheck": "npm run prisma:generate",
    "check": "tsc --noEmit && eslint src/",
    "pretest": "npm run prisma:generate",
    "test": "vitest run",
    "pretest:watch": "npm run prisma:generate",
    "test:watch": "vitest",
    "pretest:coverage": "npm run prisma:generate",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test",
    "test:e2e:smoke": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test --grep @smoke --project='Desktop Chrome'",
    "test:e2e:mcp": "playwright test --config=playwright.mcp.config.ts",
    "test:e2e:desktop": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test --project='Desktop Chrome'",
    "test:e2e:security": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test --grep @security",
    "test:e2e:regression": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test --grep @regression",
    "test:e2e:visual": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test --grep @visual --project='Desktop Chrome'",
    "test:e2e:visual:update": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test --grep @visual --project='Desktop Chrome' --update-snapshots",
    "test:e2e:a11y": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test --grep @a11y --project='Desktop Chrome'",
    "test:e2e:error": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test --grep @error",
    "test:e2e:ui": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test --ui",
    "test:e2e:headed": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test --headed",
    "test:e2e:reset": "tsx tests/e2e/scripts/reset-db.ts",
    "test:e2e:generate": "tsx tests/e2e/scripts/generate-fixtures.ts",
    "test:e2e:seed": "DATABASE_URL=postgresql://besedy_test:besedy_test@localhost:5434/besedy_test tsx prisma/seed-test.ts",
    "test:e2e:mobile": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test tests/e2e/mobile/ --project='Pixel 7' --project='Galaxy Tab S4' --project='iPhone 14'",
    "test:e2e:mobile:headed": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test tests/e2e/mobile/ --project='Pixel 7' --headed",
    "test:e2e:mobile:visual": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test tests/e2e/mobile/responsive-layouts.spec.ts --project='Desktop Chrome'",
    "test:e2e:mobile:update": "TEST_RUN_ID=$(date +%Y%m%d_%H%M%S) playwright test tests/e2e/mobile/ --update-snapshots",
    "test:e2e:visual-gallery": "tsx tests/e2e/scripts/generate-visual-report.ts",
    "catalog:sync": "tsx scripts/sync-catalog-db.ts",
    "catalog:verify": "tsx scripts/verify-catalog-db-parity.ts",
    "events:normalize-singletons": "tsx scripts/normalize-single-recording-events.ts",
    "i18n:report": "tsx scripts/i18n-report.ts --out i18n-report.json",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed-dev.ts",
    "db:studio": "prisma studio",
    "audit:dependencies": "node scripts/audit-dependencies.mjs"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.1",
    "@better-auth/core": "1.7.1",
    "@better-auth/mcp": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/server": "2.0.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.22",
    "@radix-ui/react-avatar": "^1.2.5",
    "@radix-ui/react-checkbox": "^1.3.10",
    "@radix-ui/react-dialog": "^1.1.22",
    "@radix-ui/react-dropdown-menu": "^2.1.23",
    "@radix-ui/react-label": "^2.1.14",
    "@radix-ui/react-popover": "^1.1.22",
    "@radix-ui/react-scroll-area": "^1.2.17",
    "@radix-ui/react-select": "^2.3.6",
    "@radix-ui/react-separator": "^1.1.14",
    "@radix-ui/react-slider": "^1.4.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.6",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.8",
    "better-auth": "1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "pdfmake": "^0.3.11",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "yazl": "^3.3.1",
    "zod": "^4.2.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/papaparse": "^5.5.2",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^27.3.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "browserslist": "4.28.8",
    "deepmerge-ts": "8.0.2",
    "find-my-way": "9.7.0",
    "mysql2": "3.24.2",
    "postcss": "8.5.23",
    "sharp": "$sharp",
    "valibot": "1.4.2"
  }
}
