# Production environment configuration
# Copy to .env.prod and fill in actual values
# DO NOT COMMIT .env.prod

# Environment mode (controls runtime behavior)
APP_ENV=production
BUILD_TARGET=production

# Ports (localhost only for security - reverse proxy handles external)
WEB_PORT=127.0.0.1:3000
DB_PORT=127.0.0.1:5432

# Config file — keep this outside the checkout so fresh-worktree deploys can
# mount the same file. The path must be absolute and the file must be readable
# by the container user (normally mode 0644).
CONFIG_FILE=/absolute/path/outside/checkout/besedy.container.toml
CONFIG_MOUNT=/data/config/besedy.toml
BESEDY_CONFIG=/data/config/besedy.toml
DB_INIT_SCRIPT=./init-db-users.sh

# Database - main superuser (for backups and admin)
POSTGRES_USER=besedy
POSTGRES_PASSWORD=<strong-password-here>
POSTGRES_DB=besedy

# Database - separate credentials for security (least privilege)
# MIGRATE_PASSWORD: Used only from host for schema migrations (full DDL)
# APP_PASSWORD: Used by web container at runtime (DML only, no DELETE on audit_log)
MIGRATE_PASSWORD=<strong-migrator-password>
APP_PASSWORD=<strong-app-password>
# Use the same password as APP_PASSWORD above
DATABASE_URL=postgresql://besedy_app:<strong-app-password>@db:5432/besedy

# Deployment workflow (from the repo root; see docs/web/operations.md):
#   just prod-up       # start the existing production images; does not rebuild
#   just prod-deploy   # checks, rebuilds, starts, migrates, and restarts
# `prod-migrate` grants access to newly migrated tables and then re-applies the
# audit_log DELETE revoke automatically.

# Authentication
AUTH_SECRET=<random-32-byte-secret>
# AUTH_URL: Recommended for production - prevents Host header injection attacks
# Set to your canonical HTTPS URL (e.g., https://your-domain.com)
AUTH_URL=https://your-domain.com
# Public app URL baked into client bundle (manifest, links)
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Extra auth origins if you terminate TLS elsewhere or use alternate hostnames
# AUTH_EXTRA_ORIGINS=https://alt.example.com

# Trust reverse-proxy client-IP headers for auth rate limiting (default: off).
# There is no direct request IP on this stack, so with this OFF the auth rate
# limiter keys on a request fingerprint (session-token prefix + user-agent +
# client hints + forwarded IP); an unauthenticated caller can rotate those
# headers to dodge the limit. With it ON, the limiter keys on the forwarded
# client IP, reading `cf-connecting-ip` first and then `x-forwarded-for`.
#
# `cf-connecting-ip` is trusted unconditionally, so enable this ONLY when the
# origin is reachable exclusively through the trusted proxy — lock ingress to
# Cloudflare's IP ranges (or front it with a proxy that overwrites the header).
# If the origin is directly reachable, a client can set `cf-connecting-ip` to a
# fresh value per request and bypass the limit entirely. Cloudflare sets
# `cf-connecting-ip` authoritatively for traffic through it (and appends, not
# strips, `x-forwarded-for`), but does not stop direct-to-origin spoofing.
# TRUST_PROXY_HEADERS=true

# Data directories (explicit container mounts)
# Catalog projection reconciliation starts in the background during server
# bootstrap. Keep the last successful projection available on errors by
# default; set readiness to true when a running or outdated projection must
# take the instance out of service. Readiness cannot be required when startup
# sync is disabled.
CATALOG_SYNC_STARTUP_ENABLED=true
CATALOG_SYNC_REQUIRED_FOR_READINESS=false

# Text data: catalogs and transcripts (mounted at /data/text in container)
TEXT_DATA_DIR=/path/to/text/data
# Posters (mounted at /data/posters in container)
POSTERS_DIR=/path/to/posters
# Recording sources (mounted at /data/sources in container)
SOURCES_DIR=/path/to/sources
# Audio files for streaming (mounted at /data/audio in container)
AUDIO_DIR=/path/to/audio/files
# Original audio files for download (mounted at /data/original in container)
ORIGINAL_AUDIO_DIR=/path/to/original/audio
# Web logs (host bind mount, daily files: web-YYYY-MM-DD.log)
# Ensure the directory exists and is writable by container UID 1001.
WEB_LOGS_DIR=/path/to/web/logs/production

# Additional allowed paths for validation (container paths, comma-separated)
# Include /data/original if serving original files
BESEDY_ALLOWED_PATHS=/data/original

# Path mappings: rewrite host paths in CSV catalogs to container paths
# Format: /host/path=/container/path,/other/host=/other/container
# Example: /mnt/data/audio=/data/original
BESEDY_PATH_MAPPINGS=

# Backup directory (MUST be outside TEXT_DATA_DIR/AUDIO_DIR for security)
BACKUP_DIR=/path/to/backups
# Host UID/GID used by backup container when writing to BACKUP_DIR.
# Set these to the owner of BACKUP_DIR on your host (run: id -u / id -g).
BACKUP_UID=1000
BACKUP_GID=1000

# OAuth providers (required in production)
AUTH_GOOGLE_ID=<client-id>
AUTH_GOOGLE_SECRET=<client-secret>
# AUTH_GITHUB_ID=<client-id>
# AUTH_GITHUB_SECRET=<client-secret>

# Push notifications (for new event alerts)
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<base64-public-key>
VAPID_PRIVATE_KEY=<base64-private-key>
VAPID_SUBJECT=mailto:your@email.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<same-as-VAPID_PUBLIC_KEY>
# Support email shown in the UI
# Preferred plain-text option:
# NEXT_PUBLIC_SUPPORT_EMAIL=info@your-domain.com
# Optional obfuscated option (used when NEXT_PUBLIC_SUPPORT_EMAIL is unset):
NEXT_PUBLIC_SUPPORT_EMAIL_B64=aW5mb0BleGFtcGxlLmNvbQ==

# Jobs service secret (protects internal deep-search endpoints)
BESEDY_JOB_SERVICE_SECRET=<random-hex-string>

# RAG search
# Production uses the shared ColBERT sidecar.
RAG_BACKEND_KEY=faster-whisper/large-v3@silero_vad_v6@lang-auto
RAG_RERANK_MODEL=Alibaba-NLP/gte-multilingual-reranker-base
# ColBERT mode no longer requires the TEI reranker by default.
RAG_COLBERT_RERANK_ENABLED=false
# Keep the TEI reranker URL only if you explicitly re-enable ColBERT reranking.
RAG_TEI_RERANK_URL=http://host.docker.internal:8191/rerank
RAG_TEI_TIMEOUT_MS=8000
RAG_COLBERT_URL=http://host.docker.internal:8192/query
RAG_COLBERT_TOP_K=200
RAG_COLBERT_MODEL=jinaai/jina-colbert-v2
RAG_COLBERT_ROOT_DIR=/workspace/besedy/tmp/rag_colbert
RAG_RERANK_TOP_N=50
RAG_RESULT_LIMIT=50
RAG_RELATIVE_SCORE_CUTOFF=0
