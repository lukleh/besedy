# Private rsnapshot profile. Copy outside the checkout and chmod 600.
# Usage: SNAPSHOT_ENV_FILE=/path/to/profile.env bash web/scripts/rsnapshot-backup.sh daily
# This is trusted shell configuration, like ops.env. Quote paths containing spaces.

# Use SOURCE_DIR for one source, or SNAPSHOT_MAP_FILE for mapped sources.
# A configured map takes precedence over SOURCE_DIR.
SOURCE_DIR=/path/to/projects
BACKUP_LABEL=projects/
# SNAPSHOT_MAP_FILE=/path/to/besedy-extra.paths

SNAPSHOT_ROOT=/path/to/snapshots
RSNAPSHOT_CONFIG=/path/to/rsnapshot.conf
LOG_FILE=/path/to/snapshot.log
DETAIL_LOG_FILE=/path/to/snapshot-detail.log
LOCK_FILE=/path/to/snapshot.lock
RSNAPSHOT_LOCK_FILE=/path/to/rsnapshot.pid

ENABLE_REMOTE_SYNC=1
SYNC_TARGET=backup-user@backup-host::backup-module/snapshots/
PASSWORD_FILE=/path/to/rsync-password
ALERT_EMAIL="${ALERT_EMAIL-ops@example.com}"
# EXCLUDE_FILE=/path/to/rsnapshot.exclude

RETAIN_DAILY=7
RETAIN_WEEKLY=4
RETAIN_MONTHLY=12
RETAIN_YEARLY=5

# Enable these only in the Besedy-extra profile; runner invokes them daily only.
# BESEDY_COMPOSE_DIR=/path/to/production/web
# BEFORE_SNAPSHOT_HOOK=/path/to/production/web/scripts/db-snapshot-hook.sh
# AFTER_SYNC_HOOK=/path/to/production/web/scripts/db-snapshot-hook.sh
