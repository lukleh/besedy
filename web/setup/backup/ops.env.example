# Besedy operational/backup paths for the web/scripts/*.sh monitoring tooling.
#
# Copy this file to an untracked location and fill in the real paths:
#   ~/.config/lukleh/besedy/ops.env
# or point BESEDY_OPS_ENV at it:
#   export BESEDY_OPS_ENV=/path/to/ops.env
#
# backup-health-check.sh, host-backup-health-check.sh and weekly-report.sh
# source this file and fail with a clear error if a value below is left unset.
# Snapshot jobs use separate private profiles based on snapshot.env.example.
# Those profiles may source this file to keep runner and monitoring paths aligned.

# Directory holding the production DB dumps (backup-health-check.sh).
BACKUP_DIR=/path/to/besedy/web/backups

# Database NAS readback verification (db-snapshot-hook.sh and host health check).
# Must equal SYNC_TARGET of the Besedy-extra daily job, including trailing slash.
DB_BACKUP_REMOTE_TARGET=backup-user@backup-host::backup-module/snapshots/
DB_BACKUP_PASSWORD_FILE=/path/to/rsync-password
DB_BACKUP_MAX_AGE_HOURS=24

# Host-side rsnapshot roots (host-backup-health-check.sh, weekly-report.sh).
PROJECT_SNAPSHOT_ROOT=/path/to/Backups/rsnapshot
EXTRA_SNAPSHOT_ROOT=/path/to/Backups/rsnapshot_besedy_extra

# rsnapshot log files parsed for the last-run status.
PROJECT_LOG_FILE=/path/to/logs/linuxbackup_rsnapshot.log
EXTRA_LOG_FILE=/path/to/logs/besedy_extra_rsnapshot.log

# Optional remote sync trend thresholds (host-backup-health-check.sh); a breach
# sends a "Host backup trend WARNING" email. Defaults shown.
# REMOTE_SYNC_MAX_DURATION_MINUTES=120
# REMOTE_SYNC_MAX_GROWTH_PERCENT=25
# REMOTE_SYNC_GROWTH_WINDOW_DAYS=7
# An unchanged warning is emailed again only after this many hours (0 = every
# run); the check still exits 3 and logs it. State lives in HOST_BACKUP_STATE_FILE.
# REMOTE_SYNC_WARNING_REPEAT_HOURS=168
# HOST_BACKUP_STATE_FILE=~/.local/state/lukleh/besedy/host-backup-trend.state
