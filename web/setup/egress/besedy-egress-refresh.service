[Unit]
Description=Backstop Besedy Docker egress controls if they have drifted
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# The event watcher normally reconciles network changes immediately. Verify
# quietly on a timer as a backstop, and only reapply — and log — when the live
# rules no longer match the live networks, so the journal stays meaningful.
ExecStart=/bin/sh -c '/usr/local/bin/iptables-egress.sh --verify >/dev/null 2>&1 || /usr/local/bin/iptables-egress.sh'
StandardOutput=journal
StandardError=journal
