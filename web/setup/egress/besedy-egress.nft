#!/usr/sbin/nft -f
# Besedy container egress policy. See docs/web/egress-isolation.md.
#
# Applies to every interface named br-bsdy*: the bridges of the Docker networks
# Besedy creates (scripts/docker_network.sh and the compose driver_opts).
# Containers keep internet access; new connections to the host itself and to
# private, tailnet, and link-local addresses are dropped.
#
# The table is Besedy's own, so Docker, ufw, Tailscale, and libvirt never
# rewrite it. A drop in any base chain is final: an accept in another table
# (Tailscale's ts-forward, ufw's SSH rule) cannot let the packet through.
#
# Loading this file replaces the table in one transaction. If the file does not
# parse, nft changes nothing and the previous policy stays in place.

table inet besedy_egress
delete table inet besedy_egress

table inet besedy_egress {
	set blocked_v4 {
		type ipv4_addr
		flags interval
		elements = {
			10.0.0.0/8,       # RFC 1918
			100.64.0.0/10,    # CGNAT, used by the tailnet
			169.254.0.0/16,   # link-local
			172.16.0.0/12,    # RFC 1918, includes every Docker bridge subnet
			192.168.0.0/16,   # RFC 1918, LAN and libvirt
		}
	}

	# Priority mangle (-150) runs after conntrack (-200), so replies can be told
	# apart, and before DNAT (-100), so the destination is the address the
	# container asked for, also for the host's published ports.
	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;

		iifname != "br-bsdy*" accept

		# Besedy networks are IPv4-only (enable_ipv6: false).
		meta nfproto ipv6 counter drop comment "ipv6"

		# Replies to connections opened into a container (cloudflared, the
		# LAN to a published port, host CLI to ColBERT).
		ct state established,related accept

		# The host's own addresses, and broadcast and multicast, which reach
		# host daemons on 0.0.0.0 (nmbd, avahi) without a local address.
		fib daddr type { local, broadcast, multicast } counter drop comment "host"
		ip daddr @blocked_v4 counter drop comment "private"
	}
}
