# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.config-link-*/
/tests/e2e/fixtures/
/test-output/
/test-results/
/qa-results/
/playwright-report/
/playwright/.cache/

# Visual regression test diffs (baselines are committed)
/tests/e2e/snapshots/**/*-diff.png
/tests/e2e/snapshots/**/*-actual.png

# next.js
/.next
/.next/
/.cache-next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Environment secrets (local paths and credentials)
.env.dev
.env.prod

# Security contact file (contains personal email)
/public/.well-known/security.txt

# Backups
/backups

# Host-mounted web logs
/logs

# Script output
/scripts/output/

# Real site-specific config (ship only the .example variants)
/besedy.container.toml
/setup/backup/besedy-extra.paths
