# Besedy Web Frontend - Environment Variables
# For host-run local development, copy to .env.local and configure.
# Docker uses the mode-specific .env.dev/.prod/.test.example templates instead.

# Environment mode (development | test | production)
# Controls runtime behavior: rate limiting, OAuth mode, security headers
APP_ENV=development

# Base directory for pipeline artifacts and the web configuration
BESEDY_BASE_DIR=/path/to/besedy/data
# Required: explicitly select an existing active source after archive preflight.
# Use the same ID in the matching jobs/worker environment; there is no fallback.
# New database setup: docs/web/single-archive.md (archive:register).
BESEDY_ARCHIVE_ID=
# Optional: path to besedy.toml (recommended if config lives outside repo root)
# If unset, web expects besedy.toml inside BESEDY_BASE_DIR.
# BESEDY_CONFIG=/path/to/besedy.toml

# Additional allowed paths for audio files (comma-separated)
# Use this when audio files are mounted outside BESEDY_BASE_DIR
# BESEDY_ALLOWED_PATHS=/mnt/audio-archive,/mnt/recordings

# Optional: host directory for persisted web logs when running in Docker Compose
# Daily log files are written as web-YYYY-MM-DD.log
# WEB_LOGS_DIR=./logs/development/web

# Database
DATABASE_URL=postgresql://besedy:besedy@localhost:5432/besedy

# Authentication (Phase 1c)
AUTH_SECRET=<random-32-byte-secret>    # Generate with: openssl rand -base64 32
# AUTH_TRUST_HOST=true                 # Required for Docker/reverse proxy
# AUTH_URL=http://localhost:3001       # Override for LAN access (e.g., http://192.168.1.x:3001)
# NEXT_PUBLIC_APP_URL=http://localhost:3001  # Public app URL baked into client (manifest, links)
# AUTH_DEV_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# AUTH_EXTRA_ORIGINS=http://100.x.y.z:3001,http://my-tailscale-host:3001
# OAUTH_MOCK_URL=http://oauth-mock:8090 # Dev/test only (with --profile mock-oauth)

# OAuth Providers (Google is required in production)
# AUTH_GOOGLE_ID=<google-client-id>
# AUTH_GOOGLE_SECRET=<google-client-secret>
# AUTH_GITHUB_ID=<github-client-id>
# AUTH_GITHUB_SECRET=<github-client-secret>

# Superadmin Bootstrap
# Configure superadmin_email in besedy.toml [web] section.
# That email will be auto-created as superadmin on first OAuth login.

# Support Email
# Option 1: plain support email (easy to configure)
# NEXT_PUBLIC_SUPPORT_EMAIL=info@example.com
# Option 2: base64-encoded support email (avoids plain-text literal in code/config)
# Generate with: echo -n "info@example.com" | base64
# NEXT_PUBLIC_SUPPORT_EMAIL_B64=aW5mb0BleGFtcGxlLmNvbQ==
