# Development environment configuration
# Copy to .env.dev and update paths for your system

# Environment mode (controls runtime behavior)
APP_ENV=development
BUILD_TARGET=development

# Ports
WEB_PORT=3001
DB_PORT=5433

# Database (required)
DATABASE_URL=postgresql://besedy:besedy@db:5432/besedy

# Mock OAuth server (Docker-internal URL, used by better-auth generic OAuth plugin)
OAUTH_MOCK_URL=http://oauth-mock:8090

# Config file
CONFIG_FILE=./besedy.docker.toml
CONFIG_MOUNT=/data/config/besedy.docker.toml
BESEDY_CONFIG=/data/config/besedy.docker.toml

# Auth URL - base URL for OAuth redirects (used for better-auth baseURL)
AUTH_URL=http://192.168.1.x:3001
# Public app URL (baked into client bundle, used by manifest)
NEXT_PUBLIC_APP_URL=http://192.168.1.x:3001

# Auth secret (required)
AUTH_SECRET=<random-32-byte-secret>

# Extra trusted origins for authentication (comma-separated)
# Add Tailscale IPs or other access methods here
# Example: AUTH_EXTRA_ORIGINS=http://100.x.y.z:3001
AUTH_EXTRA_ORIGINS=
# Localhost origins trusted by Better Auth in development
# Override only if you use non-standard local ports.
AUTH_DEV_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Extra allowed dev origins for Next.js (comma-separated, without protocol)
# These are added to allowedDevOrigins in next.config.ts
# Hostnames or IP addresses accepted by Next.js allowedDevOrigins (no scheme/port).
# Example: DEV_EXTRA_ORIGINS=192.168.1.x,100.x.y.z
DEV_EXTRA_ORIGINS=

# Data directories (required)
TEXT_DATA_DIR=/path/to/text/data       # Contains catalogs/ and transcripts/
POSTERS_DIR=/path/to/posters           # Writable posters storage
SOURCES_DIR=/path/to/sources           # Writable sources storage
AUDIO_DIR=/path/to/audio/files         # Staged/archived audio files for streaming
# Web logs (host bind mount, daily files: web-YYYY-MM-DD.log)
# Ensure the directory exists and is writable by container UID 1001.
WEB_LOGS_DIR=./logs/development/web

# Original audio files for download (optional)
ORIGINAL_AUDIO_DIR=/path/to/original/audio

# Legacy audio archives (optional)
# These are for additional audio locations referenced in existing catalogs
AUDIO_LEGACY_DIR=/path/to/legacy/audio
AUDIO_ARCHIVE_DIR=/path/to/archive/audio

# Additional allowed paths for validation (container paths, comma-separated)
BESEDY_ALLOWED_PATHS=/data/original,/data/audio-legacy,/data/audio-archive

# Path mappings: rewrite host paths in CSV catalogs to container paths
# Format: /host/path=/container/path,/other/host=/other/container
# Example: /mnt/data/audio=/data/original
BESEDY_PATH_MAPPINGS=

# Push Notifications (required)
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<base64-public-key>
VAPID_PRIVATE_KEY=<base64-private-key>
VAPID_SUBJECT=mailto:dev@besedy.test
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<same-as-VAPID_PUBLIC_KEY>
# Support email shown in the UI
# Preferred plain-text option:
# NEXT_PUBLIC_SUPPORT_EMAIL=info@besedy.test
# Optional obfuscated option (used when NEXT_PUBLIC_SUPPORT_EMAIL is unset):
NEXT_PUBLIC_SUPPORT_EMAIL_B64=aW5mb0BiZXNlZHkudGVzdA==
BESEDY_JOB_SERVICE_SECRET=dev-jobs-service-secret-12345

# Network Simulation (dev only)
# These settings are defaults that can be overridden via the dev panel or query params
# NETWORK_SIM_ENABLED=false        # Enable network simulation on startup
# NETWORK_SIM_MODE=slow            # Mode: slow, intermittent, flaky, timeout, offline, throttled
# NETWORK_SIM_DELAY_MS=1000        # Latency delay in milliseconds
# NETWORK_SIM_BANDWIDTH_KBPS=0     # Bandwidth limit (0 = no limit). Examples: 400 (3G), 4000 (4G)
# NETWORK_SIM_FAILURE_RATE=0       # Percentage of requests that fail (0-100)
# NETWORK_SIM_PRESET=              # Use a preset: 2g, slow-3g, fast-3g, 4g, slow-wifi, flaky-wifi, offline

# RAG search
RAG_BACKEND_KEY=faster-whisper/large-v3@silero_vad_v6@lang-auto
# Keep only if you explicitly enable ColBERT reranking.
RAG_TEI_RERANK_URL=http://host.docker.internal:8191/rerank
RAG_TEI_TIMEOUT_MS=8000
RAG_RERANK_TOP_N=50
RAG_RESULT_LIMIT=50
RAG_RELATIVE_SCORE_CUTOFF=0
