# Test (E2E) environment configuration
# Preferred runtime location:
#   ~/.config/lukleh/besedy/web.env.test

# Environment mode
APP_ENV=test
BUILD_TARGET=production

# Ports (different from dev to allow parallel running)
WEB_PORT=3002
DB_PORT=5434

# Database (separate from dev)
POSTGRES_USER=besedy_test
POSTGRES_PASSWORD=besedy_test
POSTGRES_DB=besedy_test
POSTGRES_VERSION=17
DB_HEALTHCHECK_INTERVAL=2s
DB_HEALTHCHECK_RETRIES=10
DATABASE_URL=postgresql://besedy_test:besedy_test@db:5432/besedy_test

# Auth
AUTH_SECRET=test-secret-for-e2e-tests-32bytes
AUTH_URL=http://localhost:3002
AUTH_DEV_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
OAUTH_MOCK_URL=http://oauth-mock:8090

# Data (fixtures directory)
TEXT_DATA_DIR=./tests/e2e/fixtures
POSTERS_DIR=./tests/e2e/fixtures/posters
SOURCES_DIR=./tests/e2e/fixtures/sources
AUDIO_DIR=./tests/e2e/fixtures/audio
ORIGINAL_AUDIO_DIR=./tests/e2e/fixtures/original
BESEDY_CONFIG=/data/config/besedy.docker.toml

# Push notifications (optional in tests). Leave unset to disable push, or
# generate a throwaway pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=<base64-public-key>
# VAPID_PRIVATE_KEY=<base64-private-key>
VAPID_SUBJECT=mailto:test@besedy.test
NEXT_PUBLIC_SUPPORT_EMAIL_B64=aW5mb0BiZXNlZHkudGVzdA==
BESEDY_JOB_SERVICE_SECRET=test-jobs-service-secret-12345

# RAG search (the test web env expects the shared ColBERT service to be running)
RAG_BACKEND_KEY=faster-whisper/large-v3@silero_vad_v6@lang-auto
RAG_COLBERT_RERANK_ENABLED=false
RAG_TEI_RERANK_URL=http://host.docker.internal:8191/rerank
RAG_TEI_TIMEOUT_MS=8000
RAG_COLBERT_URL=http://host.docker.internal:8192/query
RAG_COLBERT_TOP_K=200
RAG_COLBERT_MODEL=jinaai/jina-colbert-v2
RAG_COLBERT_ROOT_DIR=/data/state/rag_colbert
RAG_RERANK_TOP_N=50
RAG_RESULT_LIMIT=50
RAG_RELATIVE_SCORE_CUTOFF=0
