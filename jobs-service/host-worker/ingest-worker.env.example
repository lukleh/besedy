# Environment for the host-side Besedy ingest Prefect worker.
# Copy to ~/.config/lukleh/besedy/ingest-worker.env and fill in the values.
#
# The worker executes the same CLI the operator runs by hand, so everything the
# pipeline reads from the process environment must be present here.

# Shared Prefect control plane (published on the host by jobs-service/docker-compose.prefect.yml)
PREFECT_API_URL=http://127.0.0.1:4200/api

# Work pool registered by `just jobs-prod-deploy` (or jobs-dev-deploy / jobs-test-deploy).
# One pool per web environment: besedy-ingest-prod | besedy-ingest-dev | besedy-ingest-test
PREFECT_INGEST_WORK_POOL=besedy-ingest-prod

# Web app this worker reports completion to. Production web binds 127.0.0.1:3000;
# development listens on 3001.
BESEDY_INTERNAL_BASE_URL=http://127.0.0.1:3000
# Must match BESEDY_JOB_SERVICE_SECRET of that web environment.
BESEDY_JOB_SERVICE_SECRET=<same-value-as-web>
BESEDY_INTERNAL_TIMEOUT_MS=30000

# Host besedy.toml with host paths ([paths].uploads_dir, text_data_dir, ...).
BESEDY_CONFIG=/home/<user>/.config/lukleh/besedy/besedy.toml

# Pipeline runtime inputs normally taken from the operator shell.
RAG_BACKEND_KEY=faster-whisper/large-v3@silero_vad_v6@lang-auto
HF_TOKEN=<hugging-face-token-for-pyannote>

# systemd user services get a minimal PATH; include uv, docker and ffmpeg.
PATH=/home/<user>/.local/bin:/usr/local/bin:/usr/bin:/bin
