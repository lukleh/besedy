# systemd user unit for the host-side Besedy ingest worker.
#
# The ingest flow runs `catalog add` / `catalog run-pipeline`, which launch the
# GPU backend containers through the host Docker daemon, so this worker must run
# on the host as the operator user (not inside the hardened jobs containers).
#
# It runs from the dedicated checkout ~/worktrees/besedy/prod-ingest, which
# `just ingest-worker-deploy <rev>` creates and updates, never from the dev
# checkout: merges, branch switches and `just setup` there must not change
# production ingest.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp jobs-service/host-worker/besedy-ingest-worker.service ~/.config/systemd/user/
#   cp jobs-service/host-worker/ingest-worker.env.example ~/.config/lukleh/besedy/ingest-worker.env
#   # edit the env file, then:
#   systemctl --user daemon-reload
#   systemctl --user enable besedy-ingest-worker
#   just ingest-worker-deploy        # creates the checkout and starts the worker
#   loginctl enable-linger "$USER"   # keep the user session alive after logout
#
# Logs: journalctl --user -u besedy-ingest-worker -f

[Unit]
Description=Besedy ingest Prefect worker (host, Docker/GPU access)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Deployed checkout that owns the `besedy` package and the `uv` environment.
# `--frozen` keeps the venv on the committed lock. The `ml` extra supplies the
# tokenizer that `rag-colbert-index` needs for the ingest and correction-index
# flows.
WorkingDirectory=%h/worktrees/besedy/prod-ingest
EnvironmentFile=%h/.config/lukleh/besedy/ingest-worker.env
ExecStart=/usr/bin/env bash -lc 'exec uv run --frozen --extra jobs --extra ml prefect worker start --pool "${PREFECT_INGEST_WORK_POOL}" --type process --limit 1 --install-policy never'
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=120

[Install]
WantedBy=default.target
