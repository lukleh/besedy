# Production jobs API runtime (just jobs-prod-up).
# prod-build also reads this file to resolve BESEDY_JOBS_IMAGE for web-only deploys.
# Copy to ~/.config/lukleh/besedy/jobs.env.prod, or set BESEDY_JOBS_ENV_PROD.
# Keep real environment files outside the checkout.
#
# The shared Prefect control plane uses jobs-service/.env.prefect.example.
# Compose selects this environment's ingest pool and deployment names. The
# host worker's own environment is in host-worker/ingest-worker.env.example.

# Must match BESEDY_JOB_SERVICE_SECRET in web.env.prod; required to start.
BESEDY_JOB_SERVICE_SECRET=

# Non-root identity used to build and run the immutable production API image.
JOBS_CONTAINER_UID=1000
JOBS_CONTAINER_GID=1000

# BESEDY_JOBS_IMAGE=besedy-jobs:prod
# JOBS_TMPFS_SIZE=1g

# Overrides only when the shared control plane is hosted elsewhere.
# PREFECT_API_URL=http://besedy-prefect-server:4200/api
# PREFECT_UI_URL=http://localhost:4200
