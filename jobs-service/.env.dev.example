# Development jobs runtime (just jobs-dev-up).
# Copy to ~/.config/lukleh/besedy/jobs.env.dev, or point BESEDY_JOBS_ENV_DEV at
# another path outside the checkout. Keep it out of git.
#
# The shared Prefect control plane has its own template
# (jobs-service/.env.prefect.example -> jobs.env.prefect).
#
# docker-compose.jobs-dev.yml selects the development runtime on its own: work
# pool, deployment names, web container, deep-search output directory and host
# port all default there. Add one of those variables here only to override it;
# see the overrides at the end of this file.

# Must match BESEDY_JOB_SERVICE_SECRET in web.env.dev (web/.env.dev.example
# ships the same value). jobs-dev-up refuses to start when it is empty.
BESEDY_JOB_SERVICE_SECRET=dev-jobs-service-secret-12345

# Provider secrets are worker-only runtime env. Do not pass these through
# Deep Search submit payloads or Prefect parameters.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# rlmbenchy LM profiles. The compose file has no default for these.
RLMBENCHY_LM_PROFILE=model-openrouter-openai-gpt-oss-120b_high
RLMBENCHY_SUB_LM_PROFILE=model-openrouter-openai-gpt-oss-20b_high
# ChatGPT subscription profile example:
# RLMBENCHY_LM_PROFILE=model-chatgpt-gpt-5.4_high
# RLMBENCHY_SUB_LM_PROFILE=model-chatgpt-gpt-5.4_low

# Overrides. Uncomment only to change the compose default.
#
# Besedy web instance exposing the /api/internal/deep-search/* routes; defaults
# to the dev web container. host.docker.internal:3001 works when the dev web
# app runs outside Compose. Do not configure ColBERT here; the worker reaches
# it through these web-owned routes so ACL and bundle resolution stay central.
# BESEDY_INTERNAL_BASE_URL=http://host.docker.internal:3001
#
# Label of the deep-search output subdirectory (default dev). The directory
# follows the label, so only set this one; DEEP_SEARCH_OUTPUT_DIR is derived.
# DEEP_SEARCH_OUTPUT_ENV=
#
# Host state root and config file mounted into jobs-api and prefect-worker.
# BESEDY_STATE_HOME=${HOME}/.local/state/lukleh/besedy
# BESEDY_CONFIG_FILE=${HOME}/.config/lukleh/besedy/besedy.toml
#
# chown written deep-search output to this UID/GID. Unset leaves ownership
# unchanged.
# BESEDY_OUTPUT_CHOWN_UID=
# BESEDY_OUTPUT_CHOWN_GID=
