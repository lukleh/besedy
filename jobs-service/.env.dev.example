# Development jobs API runtime (just jobs-dev-up).
# Copy to ~/.config/lukleh/besedy/jobs.env.dev, or set BESEDY_JOBS_ENV_DEV.
# Keep real environment files outside the checkout.
#
# The shared Prefect control plane uses jobs-service/.env.prefect.example.
# Compose selects this environment's ingest pool and deployment names. The
# host worker's own environment is in host-worker/ingest-worker.env.example.

# Must match BESEDY_JOB_SERVICE_SECRET in web.env.dev; required to start.
BESEDY_JOB_SERVICE_SECRET=dev-jobs-service-secret-12345

# Overrides only when the shared control plane is hosted elsewhere.
# PREFECT_API_URL=http://besedy-prefect-server:4200/api
# PREFECT_UI_URL=http://localhost:4200

# Single-archive transition: select the same existing source in web, jobs and worker.
# Unset/blank temporarily retains the current runtime; no source is selected automatically.
# BESEDY_ARCHIVE_ID=YYYYMMDD_HHMMSS
