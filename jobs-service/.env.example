# Prefect-backed jobs-service POC configuration
# Copy to jobs-service/.env and adjust as needed.

POSTGRES_VERSION=17
PREFECT_IMAGE=prefecthq/prefect:3.8.0-python3.13
PREFECT_POSTGRES_USER=prefect
PREFECT_POSTGRES_PASSWORD=prefect
PREFECT_POSTGRES_DB=prefect
PREFECT_DB_PORT=5435
PREFECT_SERVER_DATABASE_CONNECTION_URL=postgresql+asyncpg://prefect:prefect@prefect-postgres:5432/prefect
PREFECT_PORT=4200
PREFECT_UI_URL=http://localhost:4200
PREFECT_UI_API_URL=http://localhost:4200/api

JOBS_SERVICE_PORT=8390
PREFECT_DEEP_SEARCH_WORK_POOL=besedy-deep-search
PREFECT_DEEP_SEARCH_DEPLOYMENT_NAME=deep-search-default
PREFECT_DEEP_SEARCH_FULL_DEPLOYMENT_NAME=deep_search_flow/deep-search-default
PREFECT_DEEP_SEARCH_CONCURRENCY_LIMIT=10
PREFECT_WORKER_LIMIT=10

# Point this at a running Besedy web instance that exposes
# /api/internal/deep-search/* routes. Prefer the shared Docker network for the
# local dev stack; host.docker.internal:3001 also works as a fallback.
# Do not configure ColBERT here; the worker reaches it through Besedy's web-owned
# internal deep-search routes so ACL and bundle resolution stay centralized.
BESEDY_INTERNAL_BASE_URL=http://besedy-development-web:3000

# Must match BESEDY_JOB_SERVICE_SECRET in the Besedy web environment.
BESEDY_JOB_SERVICE_SECRET=dev-jobs-service-secret-12345

# Host state root mounted into jobs-api and prefect-worker. Keep deep-search
# artifacts out of the repo checkout while sharing them between service
# containers.
BESEDY_STATE_HOME=${HOME}/.local/state/lukleh/besedy
BESEDY_CONFIG_FILE=${HOME}/.config/lukleh/besedy/besedy.toml
BESEDY_CONFIG_CONTAINER=/run/besedy/config/besedy.toml
DEEP_SEARCH_OUTPUT_ENV=dev
DEEP_SEARCH_OUTPUT_DIR=/state/lukleh/besedy/deep-search/dev
BESEDY_OUTPUT_CHOWN_UID=1000
BESEDY_OUTPUT_CHOWN_GID=1000
BESEDY_INTERNAL_TIMEOUT_MS=15000

# The production jobs image and Compose runtime use this UID/GID. Match the
# owner of BESEDY_STATE_HOME so the non-root worker can persist output bundles.
JOBS_CONTAINER_UID=1000
JOBS_CONTAINER_GID=1000
# Writable ephemeral space for Prefect, Python, and RLM runtime state. The
# production root filesystem remains read-only.
JOBS_TMPFS_SIZE=1g
# Local tag assigned to the production image. Each deployment records its Git
# revision in the image's OCI labels.
BESEDY_JOBS_IMAGE=besedy-jobs:prod

# Execution mode: rlm uses the canonical besedy_deep_search workload contract.
DEEP_SEARCH_EXECUTION_MODE=rlm

# Provider secrets are worker-only runtime env. Do not pass these through
# Deep Search submit payloads or Prefect parameters.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Optional: only needed when RLMBENCHY_* profiles use model-chatgpt-* and the
# runtime is started with `just jobs-prod-up-codex`. That overlay mounts only
# this file read-only; rlmbenchy does not refresh Codex credentials. No other
# Codex config, history, or state enters the container.
CODEX_CONTAINER_HOME=/run/codex
CODEX_HOST_AUTH_FILE=${HOME}/.codex/auth.json

RLMBENCHY_LM_PROFILE=model-openrouter-openai-gpt-oss-120b_high
RLMBENCHY_SUB_LM_PROFILE=model-openrouter-openai-gpt-oss-20b_high
# ChatGPT subscription profile example:
# RLMBENCHY_LM_PROFILE=model-chatgpt-gpt-5.4_high
# RLMBENCHY_SUB_LM_PROFILE=model-chatgpt-gpt-5.4_low
RLMBENCHY_ADAPTER_MODE=auto
RLMBENCHY_SEED=1
# The hardened jobs container supports the local subprocess backend. The docker
# backend requires a daemon/socket that is intentionally not exposed.
RLMBENCHY_REPL_BACKEND=local
