# Shared Prefect control plane (just prefect-up).
# Copy to ~/.config/lukleh/besedy/jobs.env.prefect, or point BESEDY_JOBS_ENV_PREFECT
# at another path outside the checkout. Keep it out of git.
#
# The jobs runtimes (dev, test, prod) have their own templates:
# jobs-service/.env.<env>.example.

POSTGRES_VERSION=17
# The Prefect server image defaults to the version docker-compose.prefect.yml
# pins, which matches the prefect== client pin in pyproject.toml. Leave this
# unset so upgrades apply; set it only to pin a different image on purpose,
# together with BESEDY_ALLOW_PREFECT_VERSION_DRIFT=1 in the shell (just prefect-up
# refuses an image that differs from the pin otherwise).
# PREFECT_IMAGE=
PREFECT_POSTGRES_USER=prefect
PREFECT_POSTGRES_PASSWORD=prefect
PREFECT_POSTGRES_DB=prefect
PREFECT_DB_PORT=5435
PREFECT_PORT=4200
PREFECT_UI_API_URL=http://localhost:4200/api

# The server's database URL is derived by docker-compose.prefect.yml from the
# three PREFECT_POSTGRES_* values above, so changing the password here is
# enough. Set it only for a database other than the prefect-postgres container,
# or when the password contains characters that need URL-encoding.
# PREFECT_SERVER_DATABASE_CONNECTION_URL=
